+static bool waitForX11Grab()
+{
+    // Wayland kwin treats only LockState::Locked as "the session is locked" and
+    // must see that immediately. DISPLAY is also set there because of Xwayland.
+    return qgetenv("XDG_SESSION_TYPE") != "wayland" && !qgetenv("DISPLAY").isNull();
