+#include <QtGui/qwindowdefs.h>
+
 // On X11, grab the keyboard, pointer, and XInput2 master devices so other
 // clients cannot see or inject input while the greeter is up.
 // Wayland sessions return true and grab nothing; KWin already confines input.
 // A false return means the X11 lock would be insecure and the greeter must exit.
 bool establishX11InputGrab();
 void releaseX11InputGrab();
+
+// The grab is taken on the root window, before the greeter views exist.
+// Core key events then arrive for the root, and Qt only delivers a key to a
+// view whose id is the event window. Register each greeter view so those
+// events can be forwarded, and so the view gets a focus-in. Plasma 6.7 did
+// this in the parent process; that forwarder was removed in 6.8.
+void registerX11GreeterWindow(WId window);
+void unregisterX11GreeterWindow(WId window);
+void focusX11GreeterWindow(WId window);
