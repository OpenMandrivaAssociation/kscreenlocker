+
+void unregisterX11GreeterWindow(WId window)
+{
+    s_windows.removeAll(window);
+    if (s_focused == window) {
+        s_focused = s_windows.isEmpty() ? 0 : s_windows.constFirst();
+        s_focusDelivered = false;
+    }
+}
+
+void focusX11GreeterWindow(WId window)
+{
+    if (!window || !s_windows.contains(window)) {
+        return;
+    }
+    if (window == s_focused && s_focusDelivered) {
+        return;
+    }
+    s_focused = window;
+    s_focusDelivered = false;
+    if (!s_grabbed || !QX11Info::isPlatformX11()) {
+        return;
+    }
+
+    Display *dpy = QX11Info::display();
+    if (!dpy) {
+        return;
+    }
+
+    // The root grab means this window does not become the X focus on its own.
+    // Qt will not put the cursor in the password field without a focus-in.
+    XEvent ev;
+    memset(&ev, 0, sizeof(ev));
+    ev.xfocus.display = dpy;
+    ev.xfocus.type = FocusIn;
+    ev.xfocus.window = window;
+    ev.xfocus.mode = NotifyNormal;
+    ev.xfocus.detail = NotifyAncestor;
+    XSendEvent(dpy, window, False, NoEventMask, &ev);
+    XFlush(dpy);
+    s_focusDelivered = true;
 }
