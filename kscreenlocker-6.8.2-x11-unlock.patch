+
+QList<WId> s_windows;
+WId s_focused = 0;
+bool s_focusDelivered = false;
+
+class X11GrabEventFilter : public QAbstractNativeEventFilter
+{
+public:
+    bool nativeEventFilter(const QByteArray &eventType, void *message, qintptr *) override;
+};
+
+X11GrabEventFilter *s_filter = nullptr;
+
+WId windowAt(int rootX, int rootY)
+{
+    Display *dpy = QX11Info::display();
+    if (!dpy) {
+        return 0;
+    }
+    for (WId window : std::as_const(s_windows)) {
+        Window root = 0;
+        int x = 0;
+        int y = 0;
+        unsigned int width = 0;
+        unsigned int height = 0;
+        unsigned int border = 0;
+        unsigned int depth = 0;
+        if (!XGetGeometry(dpy, window, &root, &x, &y, &width, &height, &border, &depth)) {
+            continue;
+        }
+        if (rootX >= x && rootX < x + int(width) && rootY >= y && rootY < y + int(height)) {
+            return window;
+        }
+    }
+    return 0;
+}
+
+void sendKeyToWindow(xcb_key_press_event_t *event, WId target, int rootX, int rootY)
+{
+    xcb_connection_t *connection = QX11Info::connection();
+    Display *dpy = QX11Info::display();
+    if (!connection || !dpy || !target) {
+        return;
+    }
+
+    int localX = 0;
+    int localY = 0;
+    Window root = 0;
+    int x = 0;
+    int y = 0;
+    unsigned int width = 0;
+    unsigned int height = 0;
+    unsigned int border = 0;
+    unsigned int depth = 0;
+    if (XGetGeometry(dpy, target, &root, &x, &y, &width, &height, &border, &depth)) {
+        localX = rootX - x;
+        localY = rootY - y;
+    }
+
+    xcb_key_press_event_t forwarded = *event;
+    forwarded.response_type = event->response_type & ~0x80;
+    forwarded.event = target;
+    forwarded.child = XCB_WINDOW_NONE;
+    forwarded.event_x = localX;
+    forwarded.event_y = localY;
+    xcb_send_event(connection, 0, target, XCB_EVENT_MASK_NO_EVENT, reinterpret_cast<const char *>(&forwarded));
+    xcb_flush(connection);
+}
+
+bool X11GrabEventFilter::nativeEventFilter(const QByteArray &eventType, void *message, qintptr *)
+{
+    if (!s_grabbed || eventType != QByteArrayLiteral("xcb_generic_event_t")) {
+        return false;
+    }
+
+    auto *event = static_cast<xcb_generic_event_t *>(message);
+    // Events forwarded below come back with the SendEvent bit. Qt has to see those.
+    if (event->response_type & 0x80) {
+        return false;
+    }
+
+    const uint8_t type = event->response_type & 0x7f;
+    if (type != XCB_KEY_PRESS && type != XCB_KEY_RELEASE) {
+        return false;
+    }
+
+    auto *key = reinterpret_cast<xcb_key_press_event_t *>(event);
+    // Qt handles a core key only when the event window is one of its views.
+    // A root grab delivers keys for the root window instead.
+    if (key->event != QX11Info::appRootWindow()) {
+        return false;
+    }
+
+    WId target = windowAt(key->root_x, key->root_y);
+    if (!target) {
+        target = s_focused;
+    }
+    if (!target && !s_windows.isEmpty()) {
+        target = s_windows.constFirst();
+    }
+    if (!target) {
+        return false;
+    }
+
+    // A focus-in has to land before the key, or the password field drops it.
+    focusX11GreeterWindow(target);
+    sendKeyToWindow(key, target, key->root_x, key->root_y);
+    return true;
+}
+
+void installGrabEventFilter()
+{
+    if (s_filter || !qApp) {
+        return;
+    }
+    s_filter = new X11GrabEventFilter;
+    qApp->installNativeEventFilter(s_filter);
+}
+
+void removeGrabEventFilter()
+{
+    if (!s_filter) {
+        return;
+    }
+    if (qApp) {
+        qApp->removeNativeEventFilter(s_filter);
+    }
+    delete s_filter;
+    s_filter = nullptr;
+}
 }
 
