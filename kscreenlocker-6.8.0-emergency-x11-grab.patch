+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+#pragma once
+
+// Grab the X11 keyboard, pointer and XInput2 master devices from the process
+// that shows the emergency window. The greeter has already exited, so this
+// does not compete with the greeter's grab. Wayland returns true and grabs
+// nothing. A false return leaves the window up; the parent must not exit.
+bool establishParentX11InputGrab();
+void releaseParentX11InputGrab();
